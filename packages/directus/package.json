    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "init": "tsx scripts/migrate.ts",
